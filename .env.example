# Copy to .env (gitignored). Secrets: load into GitHub Actions with `gh secret set -f .env`.
# Variables (not secret) go in vars.env: `gh variable set -f vars.env`. See README "Set it up".

# The writer's model. An OpenRouter key (https://openrouter.ai/keys) works as is: it reaches
# Claude Sonnet 5.5 at Anthropic's prices plus ~5%. Any OpenAI-compatible provider works too:
# set LLM_BASE_URL and LLM_MODEL in vars.env (e.g. https://api.anthropic.com/v1 + claude-sonnet-5
# with an Anthropic key; a Pro/Max login is not an API key).
LLM_API_KEY=

# Optional: https://jina.ai reader key, only to raise the rate limit for reading bot-blocking sites
JINA_API_KEY=

# AI Twitter reads: https://twitterapi.io (pay as you go, ~$0.15 per 1,000 posts)
TWITTERAPI_KEY=

# Newsletter: https://resend.com. Verify your domain, create a segment for subscribers.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Hosting: Cloudflare account id and an API token with "Cloudflare Pages: Edit"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# X bot account: https://developer.x.com app with read+write, OAuth 1.0a user keys, pay-per-use credits
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Only for Cloudflare Pages (the signup functions), not Actions: any long random string
SUBSCRIBE_SECRET=
