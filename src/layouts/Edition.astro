---
import '../styles/main.css';
import Masthead from '../components/Masthead.astro';
import FilterBar from '../components/FilterBar.astro';
import StoryBlock from '../components/StoryBlock.astro';
import { existsSync } from 'node:fs';
import { filterAttrs, frontPage, getEditions, href, longDate, plural, type Edition } from '../editions';

// With `front`, renders the edition's front page; otherwise the page body comes from the slot.
// `description` and `image` feed the link preview (X, Slack, iMessage); the share cards that
// scripts/cards.mjs draws into public/cards are used when they exist, the edition's own otherwise.
interface Props { title: string; edition: Edition; front?: boolean; description?: string; image?: string | null }
const { title, edition, front = false, description = 'A daily AI newspaper for people who build or follow models, agents, infra, research and safety.', image } = Astro.props;
const { lead, seconds, sections } = frontPage(edition);
const RAIL = 12; // the headline rail lists the top stories; more makes the top block taller than the lead
const otherEditions = (await getEditions()).filter((e) => e.date !== edition.date).slice(0, 6);
const card = image ?? (existsSync(`public/cards/${edition.date}.png`) ? `/cards/${edition.date}.png` : null);
const page = new URL(Astro.url.pathname, Astro.site);
const analytics = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN; // Cloudflare Web Analytics: free, no cookies
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={page} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="The Daily Weight" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={page} />
    {card && <meta property="og:image" content={new URL(card, Astro.site)} />}
    <meta name="twitter:card" content={card ? 'summary_large_image' : 'summary'} />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=PT+Sans:wght@400;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap" />
    <link rel="alternate" type="application/rss+xml" title="The Daily Weight" href="/rss.xml" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to stories</a>
    <div class="page">
      <Masthead edition={edition} />
      <main id="content">
        {front ? (
          <>
            <FilterBar stories={edition.stories} />
            <p class="empty" data-empty hidden>No stories match the selected filters in today's edition.</p>
            <section class="top" id="top" aria-label="Top stories">
              <StoryBlock story={lead} size="lead" />
              {seconds.length > 0 && (
                <div class="seconds">{seconds.map((s) => <StoryBlock story={s} size="second" />)}</div>
              )}
              <aside class="rail">
                <h2>Today's headlines</h2>
                <ol>{edition.stories.slice(0, RAIL).map((s) => <li {...filterAttrs(s)}><a href={href(s)}>{s.data.title}</a></li>)}</ol>
                {edition.stories.length > RAIL && (
                  <a class="all" href="#sections">{edition.stories.length - RAIL} more stories in the sections below ›</a>
                )}
              </aside>
            </section>
            <div class="desk" id="sections">
              {sections.map((sec) => (
                <section class="section" id={sec.key} aria-labelledby={`h-${sec.key}`}>
                  <h2 id={`h-${sec.key}`}>{sec.label}</h2>
                  {sec.stories.map((s, i) => <StoryBlock story={s} size={i === 0 ? 'card' : 'brief'} />)}
                </section>
              ))}
              {otherEditions.length > 0 && (
                <nav class="section editions" aria-labelledby="h-editions">
                  <h2 id="h-editions">Previous editions</h2>
                  <ul>
                    {otherEditions.map((e) => (
                      <li><a href={`/edition/${e.date}`}>{longDate(e.date)}</a><span>{plural(e.stories.length)}</span></li>
                    ))}
                  </ul>
                  <a class="all" href="/archive">Full archive ›</a>
                </nav>
              )}
            </div>
            {edition.stories.some((s) => s.data.sample) && (
              <p class="note">This is a sample edition. The stories are illustrative and link to placeholder addresses. Photos from Wikimedia Commons, credited on each story.</p>
            )}
          </>
        ) : (
          <slot />
        )}
      </main>
      <footer class="footer">
        <p class="footer-name">The Daily Weight</p>
        <nav aria-label="Feeds and archive">
          <a href="/archive">Archive</a>
          <a href="/rss.xml">RSS</a>
          <a href="/md">Markdown</a>
          <a href="/json">JSON</a>
          <a href="/txt">Text</a>
        </nav>
        <p class="cli">
          In a terminal: <code data-cli>curl -s {new URL('/txt', Astro.site)}</code>
          <small>(Windows PowerShell: use <code>curl.exe</code>)</small>
        </p>
        <!-- Show the address the reader is actually on; the build only knows the configured site. -->
        <script is:inline>document.querySelector('[data-cli]').textContent = 'curl -s ' + location.origin + '/txt';</script>
        <p>One edition a day on models, agents, infra, research and safety. The paper ends when you reach the bottom.</p>
        <form class="subscribe" action="/api/subscribe" method="post">
          <label for="subscribe-email">The paper in your inbox every morning</label>
          <!-- A field people never see; bots fill it and are shown out quietly. -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
          <span>
            <input id="subscribe-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
            <button type="submit">Subscribe</button>
          </span>
          <small>One email a day. Unsubscribe with one click.</small>
        </form>
      </footer>
    </div>
    {analytics && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${analytics}"}`}></script>}
  </body>
</html>
