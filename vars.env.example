# Copy to vars.env (gitignored) and load with `gh variable set -f vars.env`. None of these are secret.

# The published address; also set it in .env so local builds use it
SITE_URL=https://your.domain
# Where the writer's model lives (OpenAI-compatible). Defaults: OpenRouter and Claude Sonnet 5.5.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5.5
# The curated X List to read. smol.ai's public list of ~544 AI accounts works out of the box.
X_LIST_ID=1585430245762441216
# Cloudflare Pages project name
CF_PAGES_PROJECT=the-daily-weight
# Sender for the newsletter, on the domain verified in Resend
MAIL_FROM=The Daily Weight <paper@your.domain>
# Cloudflare Web Analytics token (optional)
PUBLIC_CF_ANALYTICS_TOKEN=
# unset: schedule does nothing | dry: build, publish nothing | on: the real thing
PUBLISH=dry
